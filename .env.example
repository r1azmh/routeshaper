# Copy this file to .env. Never commit .env.
# Generate SECRET_KEY with the command in README.md; keep it between restarts.
SECRET_KEY=
# Obtain your key at https://openrouteservice.org/dev/
ORS_SECRET_KEY=

DEBUG=False
HOST_IP=127.0.0.1
HOST_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
GUNICORN_WORKERS=2
# The original solver may run for 300 seconds; allow additional API overhead.
GUNICORN_TIMEOUT=600
